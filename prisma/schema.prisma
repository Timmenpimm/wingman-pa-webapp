// Wingman PA — datamodel
//
// Postgres (Supabase, eu-west-1). Twee verbindingen, met opzet:
//   url       — transaction pooler op 6543. Serverless opent en sluit veel
//               verbindingen; de pooler vangt dat op. Geen prepared statements,
//               vandaar ?pgbouncer=true in de string.
//   directUrl — session pooler op 5432. Migraties hebben een verbinding nodig
//               die openblijft; over de transaction pooler mislukken ze.
//
// Arrays gaan als JSON-string het veld in in plaats van als String[]. Dat is
// een bewuste beperking uit de tijd dat dev op SQLite draaide: het houdt het
// schema draagbaar en de queries identiek op beide.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // transaction pooler (6543) — runtime
  directUrl = env("DIRECT_URL") // session pooler (5432) — migraties
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  timezone      String   @default("Europe/Amsterdam")
  locale        String   @default("nl")
  password_hash String?
  created_at    DateTime @default(now())

  connectors        Connector[]
  events            Event[]
  emails            Email[]
  transactions      Transaction[]
  commitments       Commitment[]
  people            Person[]
  projects          Project[]
  briefings         DailyBriefing[]
  runs              ScheduledRun[]
  runLogs           RunLog[]
  inbox             InboxItem[]
  styleCards        StyleCard[]
  settings          UserSetting[]
  toolCalls         ToolCall[]
  graphNodes        GraphNode[]
  graphEdges        GraphEdge[]
  mandates           Mandate[]
  pushSubscriptions  PushSubscription[]
  escalationEvents   EscalationEvent[]
  mandateSuggestions MandateSuggestion[]
}

model Connector {
  id                 String    @id @default(cuid())
  user_id            String
  provider           String // google | outlook | caldav | apple | gmail | imap | ponto | telegram
  type               String // calendar | mail | bank | chat | push
  label              String
  account_id         String
  access_token       String? // in productie: encrypted at rest (pgcrypto / KMS)
  refresh_token      String?
  expires_at         DateTime?
  consent_expires_at DateTime? // PSD2/Ponto: 90 dagen
  status             String    @default("active") // active | error | reauth_required | not_connected
  permission         String    @default("propose") // propose | draft | act_and_report | silent
  scopes             String    @default("[]") // JSON-array
  last_sync_at       DateTime?
  error_message      String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, provider, account_id])
}

/// Elke poging tot een actie bij een externe bron — voorgesteld, uitgevoerd of
/// geweigerd. Eén tabel voor twee dingen die anders uit elkaar lopen: de
/// wachtrij met acties die nog een "ja" nodig hebben, en het logboek van wat er
/// werkelijk gebeurd is. Een rij wordt geschreven vóór de aanroep, niet erna:
/// een call die halverwege crasht mag geen gat in het logboek achterlaten.
///
/// `summary` is de Nederlandse zin die de gebruiker te zien krijgt bij de
/// goedkeuringsvraag ("Concept-antwoord aan Stijn over de flyers"). Die maakt
/// de tool zelf uit zijn parameters — niet de UI, want alleen de tool weet wat
/// er echt gaat gebeuren. Gevoelige details horen er niet in: dit veld kan in
/// een notificatie belanden (§6.7).
model ToolCall {
  id            String    @id @default(cuid())
  user_id       String
  connector_id  String
  tool          String // "gmail.draft_reply"
  effect        String // read | draft | write
  params        String    @default("{}") // JSON
  summary       String // NL, max 120 tekens (zie src/lib/text.ts)
  status        String    @default("pending") // pending | done | failed | rejected
  notify        Boolean   @default(false) // "doen en melden" wel, "stil doen" niet
  result        String? // JSON, zonder tokens
  error_code    String? // ConnectorOffline | Authentication | Permission | ...
  error_message String?
  duration_ms   Int?
  created_at    DateTime  @default(now())
  decided_at    DateTime?
  finished_at   DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status, created_at])
}

/// Fase 1 van het mandaatmodel (src/lib/mandates/domains.ts): drie niveaus per
/// domein, in plaats van de vier standen per connector die nog op
/// Connector.permission staan (die kolom blijft, verwijderen komt later — niets
/// leest hem nog voor een gate-beslissing).
///
/// `domain` is een vrije string, net als Connector.provider/type hierboven:
/// het register met geldige waarden staat in code
/// (src/lib/mandates/domains.ts), niet in een databaseconstraint — een nieuw
/// domein toevoegen (finance, messages) raakt dan geen migratie.
///
/// `rules` is JSON en bevat vooralsnog alleen `{"notify": "melden"|"stil"}`:
/// de voorkeur voor achteraf melden bij niveau 3. Eén kolom in plaats van een
/// eigen tabel, omdat dit de eerste van waarschijnlijk een paar losse
/// per-domein voorkeuren is — een tweede kolom per voorkeur zou een migratie
/// per voorkeur betekenen.
model Mandate {
  id         String   @id @default(cuid())
  user_id    String
  domain     String // calendar | email_send | ... (src/lib/mandates/domains.ts)
  level      Int // 1 signaleren | 2 klaarzetten | 3 doen
  rules      String   @default("{}") // JSON, nu alleen {"notify": "melden"|"stil"}
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, domain])
}

/// Fase 1: de vertrouwensloop (src/lib/mandates/suggest.ts). Draait een domein
/// lang genoeg foutloos op niveau 2, dan stelt Wingman één keer voor om naar
/// niveau 3 te gaan — nooit vanzelf, altijd een vraag in Instellingen
/// (decideMandateSuggestion in src/lib/actions.ts).
///
/// Geen `@@unique([user_id, domain, status])`: dat zou een tweede *dismissed*
/// voorstel voor hetzelfde domein onmogelijk maken zodra er ooit één
/// gedismisst is, terwijl de tijd wel verder loopt (een domein kan later
/// alsnog opnieuw kwalificeren). "Eenmalig" betekent hier iets specifieks —
/// nooit een tweede voorstel zolang er al één bestaat met `to_level` 3, ongeacht
/// status — en dat is een regel die in code zit (evaluateMandateSuggestion),
/// niet iets dat een databaseconstraint kan uitdrukken.
///
/// `evidence` is het "log als bewijs" uit de opdracht: JSON
/// `{dagen, calls, rejected}` — hoeveel dagen het domein al op dit niveau
/// draait, hoeveel toolcalls daarin zijn uitgevoerd, en hoeveel daarvan
/// afgewezen zijn (altijd 0, anders was er geen voorstel).
model MandateSuggestion {
  id         String    @id @default(cuid())
  user_id    String
  domain     String // calendar | email_send | ... (src/lib/mandates/domains.ts)
  from_level Int
  to_level   Int
  evidence   String // JSON: {"dagen": 28, "calls": 6, "rejected": 0}
  status     String    @default("open") // open | accepted | dismissed
  created_at DateTime  @default(now())
  decided_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, domain, status])
}

model Event {
  id           String   @id @default(cuid())
  user_id      String
  connector_id String?
  external_id  String
  title        String
  description  String?
  start_at     DateTime
  end_at       DateTime
  timezone     String   @default("Europe/Amsterdam")
  attendees    String   @default("[]") // JSON
  location     String?
  meeting_url  String?
  status       String   @default("confirmed")
  transparency String   @default("opaque")
  is_private   Boolean  @default(false)
  confidence   Float    @default(1.0)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // De sync-engine (src/lib/sync/engine.ts) upsert op deze combinatie: een
  // adapter levert een external_id die de bron zelf al uniek maakt (met
  // provider-prefix, "google:xyz"), dus dit is de dedupe-sleutel bij een
  // hersync van dezelfde periode.
  @@unique([user_id, external_id])
  @@index([user_id, start_at])
}

model Email {
  id           String    @id @default(cuid())
  user_id      String
  connector_id String?
  external_id  String
  thread_id    String
  subject      String
  from_addr    String
  to_addrs     String    @default("[]") // JSON
  sent_at      DateTime
  body_text    String
  is_sent      Boolean   @default(false)
  is_unread    Boolean   @default(false)
  labels       String    @default("[]") // JSON
  processed    Boolean   @default(false)
  // Nullable haakje voor de extractie-fase (LLM-extractie, latere PR): NULL =
  // nog niet verwerkt. Losstaand van `processed` (dat blijft het bestaande
  // boolean-veld) omdat een timestamp ook "sinds wanneer ligt dit al" beantwoordt
  // en zich leent voor "ouder dan X uur, opnieuw proberen"-logica die een
  // boolean niet kan.
  processed_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Zie de toelichting bij Event.@@unique — zelfde dedupe-sleutel, zelfde reden.
  @@unique([user_id, external_id])
  @@index([user_id, thread_id])
}

model Transaction {
  id                  String   @id @default(cuid())
  user_id             String
  connector_id        String?
  external_id         String
  account_iban        String
  account_name        String
  amount              Float // + = bij, - = af
  currency            String   @default("EUR")
  booked_at           DateTime
  counterparty        String?
  description         String?
  category            String?
  category_confidence Float?
  transaction_type    String   @default("transfer")
  needs_review        Boolean  @default(false)
  status              String   @default("booked")
  project_id          String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, booked_at])
}

model Commitment {
  id            String    @id @default(cuid())
  user_id       String
  source        String // email | calendar | chat | manual | voice | inference
  source_ref    String
  source_label  String? // "mail 8/7", "WhatsApp 10/7"
  direction     String // i_owe | they_owe | mutual | unknown
  party         String
  party_contact String?
  what          String
  context       String?
  due_date      DateTime?
  opened_at     DateTime  @default(now())
  status        String    @default("open") // open | done | dismissed | delegated | snoozed
  snooze_until  DateTime?
  last_nudge_at DateTime?
  nudge_count   Int       @default(0)
  confidence    Float     @default(1.0)
  project_id    String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status, due_date])
}

model Person {
  id              String    @id @default(cuid())
  user_id         String
  name            String
  emails          String    @default("[]") // JSON
  organizations   String    @default("[]") // JSON
  roles           String    @default("[]") // JSON
  frequency_score Float     @default(0)
  last_contact_at DateTime?
  notes           String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(cuid())
  user_id     String
  name        String
  description String?
  status      String   @default("active") // active | on_hold | done | archived
  status_line String? // één regel, max 120 tekens
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model DailyBriefing {
  id             String   @id @default(cuid())
  user_id        String
  date           DateTime
  frog_title     String // max 40
  frog_sub       String? // max 140
  frog_implement String? // max 200
  frog_status    String   @default("open") // open | done | deferred
  coach_text     String // max 250
  priorities     String   @default("[]") // JSON: [{id,text,done}]
  confirmations  String   @default("[]") // JSON: [{id,text,answered}]
  degraded       String   @default("[]") // JSON: ["mail","ponto"]
  schema_version Int      @default(1)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, date])
}

model InboxItem {
  id         String   @id @default(cuid())
  user_id    String
  text       String
  source     String   @default("capture") // capture | siri | mail_forward | telegram
  created_at DateTime @default(now())
  status     String   @default("new") // new | triaged | dropped
  routed_to  String? // frog | priority | commitment | dropped

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model StyleCard {
  id             String   @id @default(cuid())
  user_id        String
  register       String // bekenden | zakelijk_eerste_contact | instanties
  greeting       String
  signoff        String
  avg_words      Int
  typical        String   @default("[]") // JSON: zinnen
  edited_by_user Boolean  @default(false)
  updated_at     DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, register])
}

model UserSetting {
  id      String @id @default(cuid())
  user_id String
  key     String
  value   String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, key])
}

model GraphNode {
  id      String  @id
  user_id String
  type    String // Person | Project | Commitment | Transaction | Event | EmailThread | Organization | Account | Category
  label   String
  summary String?
  cluster String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model GraphEdge {
  id      String  @id @default(cuid())
  user_id String
  from_id String
  to_id   String
  type    String // OWES | PART_OF | COMMUNICATES_WITH | HAS_TRANSACTION | ATTENDS | CATEGORIZED_AS | MENTIONS | NEXT_ACTION
  label   String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, from_id])
}

model ScheduledRun {
  id          String  @id @default(cuid())
  user_id     String
  kind        String // morning | midday | evening
  at          String // "08:00" — lokale tijd van de gebruiker
  days        String  @default("[1,2,3,4,5,6,7]") // JSON, ISO-weekdagen
  channel     String  @default("mail") // mail | push | none
  enabled     Boolean @default(true)
  // Lokale datum, niet een tijdstempel: de vraag is "is dit moment vandaag al
  // geweest", en die stel je in de kalender van de gebruiker, niet in UTC.
  last_run_on String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, kind])
  @@index([enabled])
}

model RunLog {
  id          String   @id @default(cuid())
  user_id     String
  kind        String
  ran_at      DateTime @default(now())
  local_date  String
  status      String // done | skipped | failed
  reason      String? // waarom overgeslagen of gefaald
  notified    Boolean  @default(false)
  duration_ms Int?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, ran_at])
}

/// Eén browserabonnement voor web-push (src/lib/push/webpush.ts,
/// src/lib/runs/notify.ts). Eén gebruiker kan er meerdere hebben — elk
/// toestel/browser dat "Pushmeldingen inschakelen" aanzet levert er één.
/// `endpoint` komt van de browser en is over alle gebruikers heen uniek (geen
/// twee toestellen delen er een), dus de subscribe-route kan er veilig op
/// upserten in plaats van dubbele rijen te riskeren bij een herregistratie.
model PushSubscription {
  id           String    @id @default(cuid())
  user_id      String
  endpoint     String    @unique
  p256dh       String
  auth         String
  created_at   DateTime  @default(now())
  last_used_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

/// Logboek + dedupe-sleutel van de escalatielaag (src/lib/escalation/).
/// (user_id, trigger, ref_id) mag maar één keer voorkomen: zonder die
/// beperking zou dezelfde openstaande deadline of transactie bij elke tick
/// opnieuw escaleren in plaats van precies één keer.
model EscalationEvent {
  id         String   @id @default(cuid())
  user_id    String
  trigger    String // deadline_24h | money_unexpected | ... (zie src/lib/escalation/triggers.ts)
  ref_id     String // id van het bronrecord (Commitment, Transaction, ...)
  message    String // NL, kort en discreet — nooit bedragen of schuldeisernamen (zie notify.ts)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, trigger, ref_id])
}
