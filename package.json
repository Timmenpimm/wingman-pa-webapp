{
  "name": "wingman-pa-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3111",
    "build": "prisma generate && next build",
    "start": "next start -p 3111",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate deploy && tsx prisma/seed.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:nuke": "docker compose down -v && docker compose up -d && sleep 3 && prisma migrate deploy && tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "build:check": "next build --no-lint",
    "rls:bewijs": "node --env-file=.env scripts/rls-bewijs.mjs",
    "google:sleutels": "node scripts/google-sleutels.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.8",
    "next": "^14.2.35",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.5.4",
    "vitest": "^2.1.9",
    "wait-on": "^9.1.0"
  }
}
